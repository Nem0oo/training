# Copier en .env et remplir avant docker compose up
MCP_API_KEY=change-me-with-a-strong-random-key
API_PASSWORD=change-me-with-a-strong-password
JWT_SECRET=change-me-with-a-random-64-char-string
# Secret partagé entre les services api et training-mcp, pour les appels
# serveur-à-serveur (training-mcp proxie create_seance/update_seance vers l'api).
INTERNAL_API_KEY=change-me-with-a-strong-random-key
# Accès à l'API REST en lecture seule de garmin-gateway (service séparé,
# https://github.com/Nem0oo/garmin-gateway), utilisée par le moteur de scoring
# pour récupérer les séries d'une activité
# (GET <GARMIN_BASE_URL>/api/v1/activities/<id>/series).
# GARMIN_API_KEY = valeur de REST_API_KEY du gateway (pas sa MCP_API_KEY).
# GARMIN_BASE_URL = URL racine du gateway, sans slash final ni /api/v1.
GARMIN_API_KEY=change-me-with-garmin-gateway-rest-api-key
GARMIN_BASE_URL=change-me-with-your-garmin-gateway-url
PROD_URL=training.example.com
# Fuseau horaire de l'athlète (nom IANA, ex : America/Montreal, Asia/Tokyo).
# Sert à calculer « aujourd'hui » et « cette semaine » dans les stats et le
# radar cumulé. UTC par défaut si absent.
TZ=UTC
